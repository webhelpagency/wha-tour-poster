{
	"name": "wha-tour-poster/wha-tour-poster",
	"description": "Development tooling for the WHA Tour Poster WordPress theme and its companion plugin.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3",
		"phpcompatibility/phpcompatibility-wp": "^2",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
