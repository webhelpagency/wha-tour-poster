{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wha-tours-core/lead-form",
	"version": "1.0.0",
	"title": "Lead form",
	"category": "widgets",
	"icon": "email-alt",
	"description": "Request form: name, phone and comment. Submissions are emailed and stored in Leads.",
	"keywords": [ "form", "lead", "contact", "request" ],
	"textdomain": "wha-tours-core",
	"supports": {
		"html": false,
		"multiple": true,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"button": {
			"type": "string",
			"default": ""
		},
		"note": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "wha-tours-core-lead-form-editor",
	"style": "wha-tours-core"
}
