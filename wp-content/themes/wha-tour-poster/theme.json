{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{ "slug": "pink", "color": "#E60E5F", "name": "Pink" },
				{ "slug": "pink-deep", "color": "#B8064A", "name": "Pink deep" },
				{ "slug": "pink-soft", "color": "#FDE7EF", "name": "Pink soft" },
				{ "slug": "blue", "color": "#0D60B4", "name": "Blue" },
				{ "slug": "blue-deep", "color": "#083F78", "name": "Blue deep" },
				{ "slug": "blue-soft", "color": "#E4EEF9", "name": "Blue soft" },
				{ "slug": "navy", "color": "#0A1E3D", "name": "Navy" },
				{ "slug": "sun", "color": "#FFB703", "name": "Sun" },
				{ "slug": "ok", "color": "#12A56A", "name": "Available" },
				{ "slug": "ink", "color": "#1B1A24", "name": "Ink" },
				{ "slug": "ink-2", "color": "#4A4858", "name": "Ink 2" },
				{ "slug": "ink-3", "color": "#7B7989", "name": "Ink 3" },
				{ "slug": "line", "color": "#E6E3EA", "name": "Line" },
				{ "slug": "paper", "color": "#FFFFFF", "name": "Paper" },
				{ "slug": "paper-2", "color": "#F5F3F9", "name": "Paper 2" },
				{ "slug": "night", "color": "#14131C", "name": "Night" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "oswald",
					"name": "Oswald",
					"fontFamily": "\"Oswald\", \"Arial Narrow\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Oswald",
							"fontStyle": "normal",
							"fontWeight": "200 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/oswald/oswald-variable.woff2" ]
						}
					]
				},
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope/manrope-variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.0625rem, 1rem + 0.35vw, 1.25rem)" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(1.875rem, 1.3rem + 2vw, 2.75rem)" },
				{ "slug": "xx-large", "name": "Huge", "size": "clamp(2.5rem, 1.6rem + 4.2vw, 4.5rem)" }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "4px" },
				{ "slug": "20", "name": "2", "size": "8px" },
				{ "slug": "30", "name": "3", "size": "12px" },
				{ "slug": "40", "name": "4", "size": "16px" },
				{ "slug": "50", "name": "5", "size": "24px" },
				{ "slug": "60", "name": "6", "size": "32px" },
				{ "slug": "70", "name": "7", "size": "48px" },
				{ "slug": "80", "name": "8", "size": "64px" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "24px"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--oswald)",
					"fontWeight": "600",
					"lineHeight": "1.1",
					"letterSpacing": "0.01em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--pink-deep)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--pink)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--pink)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			}
		}
	}
}
